#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

# Only Supervisor ingress (172.30.32.2) may reach the UI, even when
# SUPERVISOR_TOKEN is absent; /health stays open for the container healthcheck.
export CODEMIRROR_INGRESS_ONLY=1

cd /app
bashio::log.info "Starting CodeMirror on :8099"
exec /opt/venv/bin/gunicorn --bind 0.0.0.0:8099 --workers 1 --threads 4 \
    --timeout 180 --preload app:app
